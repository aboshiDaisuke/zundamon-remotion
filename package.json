{
  "name": "zundamon-remotion",
  "version": "1.0.0",
  "description": "Zundamon explainer video using Remotion and VOICEVOX",
  "scripts": {
    "start": "remotion preview src/index.ts",
    "build": "remotion render src/index.ts DualExplainer out/zundamon_metan.mp4 --concurrency=8",
    "render": "remotion render src/index.ts DualExplainer out/zundamon_metan.mp4 --concurrency=8",
    "still": "remotion still src/index.ts DualExplainer out/preview.png --frame=750",
    "audio": "node scripts/run_python.js scripts/generate_audio.py",
    "audio:dual": "node scripts/run_python.js scripts/generate_dual_audio.py",
    "clean": "node scripts/clean_out.js",
    "serve:web": "python3 -m http.server 8088 --directory website || python -m http.server 8088 --directory website"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.218",
    "@remotion/cli": "^4.0.218",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.218"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.2"
  }
}
